# Copie para .env.local e ajuste os valores (o .env.local NÃO é commitado).
#   Copy-Item .env.example .env.local
#
# Use apenas letras e números nas senhas: elas entram na DATABASE_URL do backend.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=financas
MYSQL_USER=app
MYSQL_PASSWORD=change-me
# Mínimo de 16 caracteres (validado pelo backend).
JWT_SECRET=change-me-to-a-long-random-string

# Opcionais
# JWT_EXPIRES_IN=1h
# CORS_ORIGIN=http://localhost:4200
# MYSQL_HOST_PORT=3306
# Só se a rede inspeciona TLS (Norton, proxy corporativo) e o build falha com
# UNABLE_TO_VERIFY_LEAF_SIGNATURE: caminho do .pem da CA (ver NODE_EXTRA_CA_CERTS).
# EXTRA_CA_FILE=C:\ProgramData\Norton\Antivirus\wscert.pem
