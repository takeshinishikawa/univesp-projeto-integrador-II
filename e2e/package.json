{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Testes de ponta a ponta (Playwright) contra a stack completa (frontend + backend + MySQL), subida via Docker Compose.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "report": "playwright show-report",
    "lighthouse": "node lighthouse/medir.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3"
  }
}
